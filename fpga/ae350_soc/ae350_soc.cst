IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

// The AE350 has a dedicated core-clock connection at this PLL site.
INS_LOC "cpu_pll" PLL_R[0];

// Dock connector J9 (SDRAM0), Sipeed SDRAM module (W9825G6KH-6). Pin
// numbers are the connector's; DQ and DQM order as the module wires them.
IO_LOC "sdram_clk" B17;      // 20
IO_LOC "sdram_cs_n" F21;     // 33
IO_LOC "sdram_ras_n" F16;    // 32
IO_LOC "sdram_cas_n" E17;    // 31
IO_LOC "sdram_we_n" D16;     // 27
