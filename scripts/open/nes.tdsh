#!/bin/tdsh
# nes.tdsh — play an NES cartridge on TinyNES, then return to the desktop.
#
# TinyDesk runs /root/scripts/open/<ext>.tdsh when a file with that extension
# is opened in the Files app or on the desktop, with FILE set to the file's
# path, so double-clicking a .nes file runs this. From the shell:
#
#     FILE="/root/data/nes/nova.nes"; tdsh run /root/scripts/open/nes.tdsh
#
# It loads the TinyNES core, has ae350run send the player program to the
# core's AE350 and the cartridge when the program asks for it, and waits for
# the game to end (HOME and - together on the controller); a tap of HOME (or
# F12) meanwhile swaps between the game and TinyDesk. Then it loads the
# desktop core again. tools/deploy_tinytang.sh in TinyNES puts the core, the
# player and this script on the card.
if "$CORE" == ""
    CORE=/root/cores/console138k/tinynes.bin
endif
if "$PLAYER" == ""
    PLAYER=/root/ae350/tinynes-play.elf
endif
if "$DESKTOP" == ""
    DESKTOP=/root/cores/console138k/desktop.bin
endif
if "$FILE" == ""
    echo "nes: no cartridge; set FILE"
    return 1
endif
if test ! -f "$FILE"
    echo "nes: no cartridge at $FILE"
    return 1
endif
if test ! -f "$CORE"
    echo "nes: no core at $CORE"
    return 1
endif
if test ! -f "$PLAYER"
    echo "nes: no player at $PLAYER"
    return 1
endif
echo "nes: $FILE"
tangload "$CORE"
if $? != 0
    echo "nes: the core did not load"
    return 1
endif
ae350run "$PLAYER" "$FILE"
RESULT=$?
# Back to the desktop core whatever happened; its layer comes back by itself.
tangload "$DESKTOP"
echo "nes: done ($RESULT)"
return $RESULT
